PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/civic-connect
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=strict
MONGO_MAX_POOL_SIZE=50

# Optional first staff account. Set all three values, then run npm run seed:staff.
BOOTSTRAP_STAFF_NAME=
BOOTSTRAP_STAFF_EMAIL=
BOOTSTRAP_STAFF_PASSWORD=
BOOTSTRAP_STAFF_ROLE=staff
